{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naturgnosis.org/schemas/administration-atlas.schema.json",
  "title": "Atlas of Government-Wide Administration Reference Systems",
  "description": "Reference systems (coordinate frames) for the space of government-wide administrative systems.",
  "$comment": "Data objects in atlas.json must keep their object key order identical to this schema's property order.",
  "type": "object",
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system"
      }
    }
  },
  "required": [
    "meta",
    "systems"
  ],
  "additionalProperties": false,
  "$defs": {
    "space": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "space": {
          "$ref": "#/$defs/space"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "space",
        "description",
        "version"
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "axis": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scale": {
          "type": "string",
          "enum": [
            "nominal",
            "ordinal"
          ]
        }
      },
      "required": [
        "group",
        "name",
        "description",
        "values",
        "scale"
      ],
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "frame_basis": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        },
        "related_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/axis"
          }
        }
      },
      "required": [
        "name",
        "title",
        "description",
        "frame_basis",
        "provenance",
        "related_notes",
        "groups",
        "axes"
      ],
      "additionalProperties": false
    }
  }
}
