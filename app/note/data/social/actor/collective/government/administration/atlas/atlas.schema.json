{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naturgnosis.org/schemas/administration-atlas.schema.json",
  "title": "Atlas of Government-Wide Administration Characterization Systems",
  "description": "Characterization systems for classifying government-wide administrative systems.",
  "$comment": "Data objects in atlas.json must keep their object key order identical to this schema's property order.",
  "type": "object",
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system"
      }
    }
  },
  "required": [
    "meta",
    "systems"
  ],
  "additionalProperties": false,
  "$defs": {
    "meta": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "description",
        "version"
      ],
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source_note": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "meta",
            "operational",
            "mixed"
          ]
        },
        "related_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          }
        }
      },
      "required": [
        "name",
        "title",
        "description",
        "source_note",
        "level",
        "related_notes",
        "categories"
      ],
      "additionalProperties": false
    },
    "category": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      },
      "required": [
        "name",
        "entries"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "concept",
            "dimension"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "critique": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "name",
        "description"
      ],
      "additionalProperties": false
    }
  }
}
