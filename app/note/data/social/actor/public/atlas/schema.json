{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naturgnosis.org/schemas/public-atlas.schema.json",
  "title": "Public Atlas Data",
  "description": "Schema for an atlas family data file (public-organization.json, gov-wide-administration.json): shared meta plus comparative representation systems with their characteristic elements.",
  "$comment": "Data objects must keep their object key order identical to this schema's property order.",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "space": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "description"
          ],
          "additionalProperties": false
        },
        "universe": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "includes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excludes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "description",
            "includes",
            "excludes"
          ],
          "additionalProperties": false
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "space",
        "universe",
        "description",
        "version"
      ],
      "additionalProperties": false
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "frame_basis": {
            "type": "string"
          },
          "provenance": {
            "type": "string"
          },
          "related_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "universe": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "value_set": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "assignment_rule": {
                  "type": "string"
                },
                "scale": {
                  "type": "string",
                  "enum": [
                    "nominal",
                    "ordinal"
                  ]
                },
                "group": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "description",
                "value_set",
                "assignment_rule",
                "scale"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "title",
          "description",
          "frame_basis",
          "provenance",
          "related_notes",
          "universe",
          "purpose",
          "version",
          "elements"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "meta",
    "systems"
  ],
  "additionalProperties": false
}
