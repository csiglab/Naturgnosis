{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naturgnosis.org/schemas/atlas.schema.json",
  "title": "Atlas of State Action",
  "description": "Synthetic seed dataset for the Atlas of State Action.",
  "$comment": "Data objects in atlas.json must keep their object key order identical to this schema's property order.",
  "type": "object",
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/problem"
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/instrument"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "required": [
    "meta",
    "problems",
    "instruments",
    "relationships"
  ],
  "additionalProperties": false,
  "$defs": {
    "meta": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "description",
        "version"
      ],
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number"
        },
        "parent": {
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "granularity": {
          "type": "string",
          "enum": [
            "broad",
            "intermediate",
            "detailed"
          ]
        },
        "policyDomain": {
          "type": "string"
        },
        "targetGroup": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "required": [
        "id",
        "parent",
        "name"
      ],
      "additionalProperties": false
    },
    "instrument": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        },
        "hue": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "icon": {
          "type": "string"
        },
        "caseStudies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caseStudy"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "mechanism",
        "hue",
        "icon",
        "caseStudies"
      ],
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "properties": {
        "problem": {
          "type": "number"
        },
        "instrument": {
          "type": "number"
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "strength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "name": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "problem",
        "instrument",
        "role",
        "strength",
        "name"
      ],
      "additionalProperties": false
    },
    "caseStudy": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "note"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    }
  }
}
