{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naturgnosis.org/schemas/polity-data.schema.json",
  "title": "Polity Manifest",
  "description": "The root manifest for the polity corpus (app/note/data/social/actor/public/polity/data.json): a catalog of per-code entries recomputed from the corpus tree, consumed by the polity aggregator and the per-polity pages.",
  "$comment": "Objects in data.json must keep their key order identical to this schema's property order. Generated by bin/build_polity_index.py.",
  "type": "object",
  "properties": {
    "generated": {
      "type": "string",
      "description": "Build date (YYYY-MM-DD)."
    },
    "root": {
      "type": "string",
      "description": "Corpus-relative root of the manifest (social/actor/public/polity)."
    },
    "count": {
      "type": "integer",
      "description": "Total entries across codes + world + international."
    },
    "codes": {
      "type": "object",
      "description": "Per-code entries, keyed by country code (directory name).",
      "additionalProperties": {
        "$ref": "#/$defs/code"
      }
    },
    "world": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "international": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    }
  },
  "required": [
    "generated",
    "root",
    "count",
    "codes",
    "world",
    "international"
  ],
  "additionalProperties": false,
  "$defs": {
    "note": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "explanation",
            "representation"
          ]
        }
      },
      "required": [
        "path",
        "title",
        "kind"
      ],
      "additionalProperties": false
    },
    "work": {
      "type": "object",
      "description": "A representation or explanation recomputed from the polity directory.",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "Temporal",
            "Spatial",
            "Network",
            "note"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "pending"
          ]
        },
        "title": {
          "type": "string"
        },
        "link": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "status",
        "title",
        "link"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "explanation": {
          "type": "integer"
        },
        "representation": {
          "type": "integer"
        }
      },
      "required": [
        "explanation",
        "representation"
      ],
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "native": {
          "type": "string"
        },
        "flag": {
          "type": "string"
        },
        "has_node": {
          "type": "boolean",
          "description": "True when the code is backed by data/node.json."
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "works": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/work"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        }
      },
      "required": [
        "name",
        "native",
        "flag",
        "has_node",
        "counts",
        "works",
        "notes"
      ],
      "additionalProperties": false
    }
  }
}
